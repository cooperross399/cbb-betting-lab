.venv/
# Tool-generated agent worktrees. Untracked and inside the repo, so a
# `git add -A` from any session would sweep a whole second checkout into a
# commit — which is how a records-corrupting commit happened here before.
.claude/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
.DS_Store

# Raw source feeds are large and reproducible from their publishers. What is
# committed is what must stay re-checkable without a network: the schedule the
# credit arithmetic is computed from, and every bought provider response,
# because bought evidence cannot be re-derived for free.
data/raw/cbb/pbp/
data/raw/cbb/team_box/
data/raw/cbb/player_box/
data/raw/cbb/schedules/
data/processed/*.csv
# The weekly loop's drift measurements. A bounded one-season cut, read by
# whoever runs the loop and never published: committing it would put a second
# set of verdicts beside the full population's for the same markets.
data/drift/
# and the frames it builds on the way there, for the same reason.
data/processed/*__weekly_drift*

# Single-season backtest bet files. The pooled file that the reports read comes
# only from the replication run; a partial set of season files sitting beside
# it is the football lab's filename collision in a different shape.
data/outputs/*_backtest_bets_[0-9]*.csv
