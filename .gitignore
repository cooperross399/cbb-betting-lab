.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.env
.DS_Store

# Raw source feeds are large and reproducible from their publishers. What is
# committed is what must stay re-checkable without a network: the schedule the
# credit arithmetic is computed from, and every bought provider response,
# because bought evidence cannot be re-derived for free.
data/raw/cbb/pbp/
data/raw/cbb/team_box/
data/raw/cbb/player_box/
data/raw/cbb/schedules/
data/processed/*.csv

# Single-season backtest bet files. The pooled file that the reports read comes
# only from the replication run; a partial set of season files sitting beside
# it is the football lab's filename collision in a different shape.
data/outputs/*_backtest_bets_[0-9]*.csv
